{
  "manifest_version": 3,
  "name": "Google Translate me",
  "version": "1.0.0",
  "description": "Google Translate me — Quick text translation and tools.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Translate me",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Google Translate me",
    "default_icon": "icons/icon-48.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "translate-me@google-tools.local",
      "strict_min_version": "112.0"
    }
  },
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.gapgpt.app/*",
    "https://api.avalai.ir/*",
    "https://api.arvancloudai.ir/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open Google Translate me"
    },
    "smart_action_x": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Smart Solve Text or Crop Screen (Ctrl+Shift+X)"
    },
    "smart_action_a": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Smart Solve Text or Crop Screen (Ctrl+Shift+A)"
    },
    "solve_clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Google Translate me — Quick Solve & Copy"
    },
    "crop_screenshot": {
      "description": "Crop Screen Selection to Copilot"
    }
  }
}